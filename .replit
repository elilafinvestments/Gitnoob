run = "node server/index.js"
entrypoint = "server/index.js"

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"
PORT = "3456"
GITNOOB_DISABLE_LOCAL_SAVE = "1"

[[ports]]
localPort = 3456
externalPort = 80

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install && npm --prefix client install && npm --prefix client run build"]
run = ["sh", "-c", "NODE_ENV=production GITNOOB_DISABLE_LOCAL_SAVE=1 PORT=3456 node server/index.js"]
